<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp" android:background="@drawable/widget_attendance_background">
  <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical" android:layout_gravity="top">
    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:id="@+id/widget_title" android:text="빠른 출결" android:textSize="20sp" android:textColor="@color/widget_text" android:includeFontPadding="false" android:layout_weight="1" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
    <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:id="@+id/widget_refresh" android:contentDescription="새로고침">
      <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/refresh_icon" android:padding="10dp" android:src="@drawable/ic_widget_refresh" android:tint="@color/widget_muted" android:importantForAccessibility="no" />
      <ProgressBar android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/refresh_spinner" android:padding="10dp" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/widget_refresh_spin" android:indeterminateTint="@color/widget_muted" android:indeterminateDuration="650" android:interpolator="@android:anim/linear_interpolator" android:visibility="gone" android:importantForAccessibility="no" />
    </FrameLayout>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/widget_body" android:gravity="center_vertical" android:layout_gravity="center_vertical" />
  <LinearLayout android:layout_width="132dp" android:layout_height="48dp" android:orientation="horizontal" android:gravity="end" android:id="@+id/widget_primary_area" android:layout_gravity="bottom|end">
    <TextView android:layout_width="132dp" android:layout_height="match_parent" android:id="@+id/widget_primary" android:text="출석하기" android:textSize="18sp" android:textColor="@color/widget_on_primary" android:includeFontPadding="false" android:gravity="center" android:background="@drawable/widget_primary_background" android:textStyle="bold" />
  </LinearLayout>
</FrameLayout>
