<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_attendance_background">
  <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:text="오늘 수업" android:textSize="20sp" android:textColor="@color/widget_text" android:includeFontPadding="false" android:layout_weight="1" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
    <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:contentDescription="새로고침">
      <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="10dp" android:src="@drawable/ic_widget_refresh" android:tint="@color/widget_muted" android:importantForAccessibility="no" />
      <ProgressBar android:layout_width="match_parent" android:layout_height="match_parent" android:padding="10dp" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/widget_refresh_spin" android:indeterminateTint="@color/widget_muted" android:indeterminateDuration="650" android:interpolator="@android:anim/linear_interpolator" android:visibility="gone" android:importantForAccessibility="no" />
    </FrameLayout>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:orientation="vertical" android:layout_weight="1">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/widget_class_background" android:layout_marginTop="4dp" android:paddingTop="2dp" android:paddingBottom="2dp">
      <FrameLayout android:layout_width="match_parent" android:layout_height="64dp">
        <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/widget_border" android:importantForAccessibility="no" android:visibility="gone" />
        <ImageView android:layout_width="3dp" android:layout_height="match_parent" android:src="@drawable/widget_class_accent" android:scaleType="fitXY" android:layout_marginTop="10dp" android:layout_marginBottom="10dp" android:importantForAccessibility="no" android:tint="#f59e0b" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="8dp">
          <TextView android:layout_width="52dp" android:layout_height="wrap_content" android:text="10:00" android:textSize="15sp" android:textColor="@color/widget_primary" android:includeFontPadding="false" android:gravity="center_vertical" android:textStyle="bold" />
          <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="대학수학(1)" android:textSize="16sp" android:textColor="@color/widget_text" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="C819" android:textSize="13sp" android:textColor="@color/widget_muted" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="3dp" />
          </LinearLayout>
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="수업 중" android:textSize="12sp" android:textColor="@color/widget_badge_info_text" android:includeFontPadding="false" android:gravity="center" android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:maxLines="1" android:background="@drawable/widget_badge_info" android:layout_marginStart="6dp" />
        </LinearLayout>
      </FrameLayout>
      <FrameLayout android:layout_width="match_parent" android:layout_height="64dp">
        <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/widget_border" android:importantForAccessibility="no" android:visibility="visible" />
        <ImageView android:layout_width="3dp" android:layout_height="match_parent" android:src="@drawable/widget_class_accent" android:scaleType="fitXY" android:layout_marginTop="10dp" android:layout_marginBottom="10dp" android:importantForAccessibility="no" android:tint="#3b82f6" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="8dp">
          <TextView android:layout_width="52dp" android:layout_height="wrap_content" android:text="12:00" android:textSize="15sp" android:textColor="@color/widget_text" android:includeFontPadding="false" android:gravity="center_vertical" android:textStyle="bold" />
          <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="교양일본어" android:textSize="16sp" android:textColor="@color/widget_text" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="C315" android:textSize="13sp" android:textColor="@color/widget_muted" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="3dp" />
          </LinearLayout>
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="예정" android:textSize="12sp" android:textColor="@color/widget_muted" android:includeFontPadding="false" android:gravity="center" android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:maxLines="1" android:background="@drawable/widget_badge_muted" android:layout_marginStart="6dp" />
        </LinearLayout>
      </FrameLayout>
      <FrameLayout android:layout_width="match_parent" android:layout_height="64dp">
        <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/widget_border" android:importantForAccessibility="no" android:visibility="visible" />
        <ImageView android:layout_width="3dp" android:layout_height="match_parent" android:src="@drawable/widget_class_accent" android:scaleType="fitXY" android:layout_marginTop="10dp" android:layout_marginBottom="10dp" android:importantForAccessibility="no" android:tint="#a855f7" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="8dp">
          <TextView android:layout_width="52dp" android:layout_height="wrap_content" android:text="14:00" android:textSize="15sp" android:textColor="@color/widget_text" android:includeFontPadding="false" android:gravity="center_vertical" android:textStyle="bold" />
          <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="전공기초영어" android:textSize="16sp" android:textColor="@color/widget_text" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="D0104" android:textSize="13sp" android:textColor="@color/widget_muted" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="3dp" />
          </LinearLayout>
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="예정" android:textSize="12sp" android:textColor="@color/widget_muted" android:includeFontPadding="false" android:gravity="center" android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:maxLines="1" android:background="@drawable/widget_badge_muted" android:layout_marginStart="6dp" />
        </LinearLayout>
      </FrameLayout>
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
