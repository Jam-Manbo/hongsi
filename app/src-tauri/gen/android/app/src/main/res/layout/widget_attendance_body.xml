<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="4dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
      <TextView android:id="@+id/attendance_course" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="19sp" android:textColor="@color/widget_text" android:textStyle="bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
      <LinearLayout android:id="@+id/attendance_status_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="5dp">
        <ImageView android:id="@+id/attendance_status_dot" android:layout_width="5dp" android:layout_height="5dp" android:layout_marginEnd="6dp" android:src="@drawable/ic_widget_attendance_dot" android:importantForAccessibility="no" android:visibility="gone" />
        <TextView android:id="@+id/attendance_message" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="12.5sp" android:fontFamily="sans-serif-medium" android:textColor="@color/widget_muted" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" />
      </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/widget_primary" android:layout_width="112dp" android:layout_height="48dp" android:layout_marginStart="12dp" android:text="출석하기" android:textSize="16sp" android:textColor="@color/widget_on_primary" android:textStyle="bold" android:includeFontPadding="false" android:gravity="center" android:background="@drawable/widget_primary_background" android:visibility="gone" />
    <LinearLayout android:id="@+id/attendance_badge_area" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:paddingHorizontal="9dp" android:paddingVertical="7dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_attendance_badge_muted" android:visibility="gone">
      <ImageView android:id="@+id/attendance_badge_icon" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="5dp" android:src="@drawable/ic_widget_tick" android:tint="@color/widget_success" android:importantForAccessibility="no" />
      <TextView android:id="@+id/attendance_badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/widget_muted" android:includeFontPadding="false" android:maxLines="1" />
    </LinearLayout>
    <ImageView android:id="@+id/attendance_symbol" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginStart="12dp" android:padding="7dp" android:background="@drawable/widget_attendance_symbol" android:src="@drawable/ic_widget_clock" android:tint="@color/widget_muted" android:importantForAccessibility="no" android:visibility="gone" />
  </LinearLayout>
  <TextView android:id="@+id/attendance_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/widget_muted" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="6dp" />
</LinearLayout>
